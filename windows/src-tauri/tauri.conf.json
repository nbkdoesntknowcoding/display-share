{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Display Share Receiver",
  "version": "0.3.0",
  "identifier": "in.theboringpeople.displayshare.receiver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Display Share Receiver",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "dialog": false,
      "endpoints": [
        "https://github.com/nbkdoesntknowcoding/display-share/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRUU5RjBBM0E2MUIwQzAKUldUQXNHRTZDcC91d21ucjVYUTlZYy8rMFBTL2d1WEtwR0dHalR2a3JOWmU3bEtCYmlIS2tJUkYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
